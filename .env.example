# Optional privacy-first PostHog custom-event delivery.
# Leave VITE_ANALYTICS_ENABLED=false and the project token blank for local-only analytics.
# These VITE_ values are compiled into browser code; never place a PostHog personal API key here.
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_PROVIDER=posthog
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_ANALYTICS_ENVIRONMENT=development
