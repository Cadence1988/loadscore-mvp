# Optional privacy-first PostHog custom-event delivery.
# Leave VITE_ANALYTICS_ENABLED=false and the project token blank for local-only analytics.
# These VITE_ values are compiled into browser code; never place a PostHog personal API key here.
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_PROVIDER=posthog
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_ANALYTICS_ENVIRONMENT=development

# Optional PRO-1 website authentication. Current Supabase projects should use
# the browser-safe publishable key from the Project Connect dialog. These values
# are compiled into browser code by Vite; Row Level Security protects later data.
# Never put a Supabase secret/service-role key or database password in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
